# Required for the AI to generate replies. Get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only for the proactive missed-call text-back (outbound SMS).
# Inbound replies go out as TwiML and need NO credentials.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Optional — locks down /voice/chat/completions so only Vapi can call it.
# If unset, the endpoint accepts any request (fine for local dev, NOT for a
# public/deployed URL). Configure the same value as a custom
# "Authorization: Bearer <this>" header on the Vapi Custom LLM connection.
# VAPI_SHARED_SECRET=
