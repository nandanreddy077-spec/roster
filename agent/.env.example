# Required for the AI to generate replies. Get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required to open the founder dashboard (/clients). Any username, this
# password. If unset, the dashboard refuses to serve (fail-closed) — the
# public landing page and self-serve /signup flow work regardless.
ADMIN_PASSWORD=pick-a-strong-password

# Signs the customer-portal session cookie (the /signup → /dashboard flow).
# In dev it falls back to an insecure default; in production it MUST be set to
# a long random value, or every deploy invalidates existing logins and the
# cookie is forgeable. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# Set to "production" in the deployed environment. When set, the app refuses to
# start if SESSION_SECRET_KEY is missing (fail-closed) rather than using the
# insecure dev fallback. Also gates the in-process background scheduler on
# (scheduler.py) — it never runs locally or during tests. Leave unset for
# local development.
ROSTER_ENV=production

# Production only. Python block-buffers print() output when stdout isn't a
# terminal, which under Railway means background work (the scheduler) can run
# correctly while producing no visible logs for a long time. Without this set,
# you will not see the scheduler's own tick output.
# PYTHONUNBUFFERED=1

# Optional — how often the in-process scheduler runs recovery_tick.run()
# (Lead Qualifier, Dispatcher, Quote Chaser enrollment, Reviews, Referral).
# Defaults to 3600 (hourly). Only takes effect when ROSTER_ENV=production.
# TICK_INTERVAL_SECONDS=3600

# Optional — Postgres connection string. Unset falls back to SQLite, written
# to ROSTER_DATA_DIR if set, else local disk. Fine at current scale (see
# agent/README.md "Why SQLite, not Postgres"); revisit only under real
# concurrent-write pressure.
# DATABASE_URL=

# Optional — where the SQLite file lives. Set to a mounted persistent volume
# path in production (e.g. /data) so the database survives redeploys.
# ROSTER_DATA_DIR=

# Optional — the public HTTPS host webhook-dependent URLs are built against.
# Has a hardcoded fallback, but set this once you have your own domain so
# nothing is built against the wrong host.
# PUBLIC_BASE_URL=https://yourdomain.com

# Optional — where the one-time "a trial client hit their spend cap" SMS alert
# is sent. Unset = no alert (the founder dashboard still shows a cap-reached
# badge on that client). Needs TWILIO_* set for the SMS to actually send.
# FOUNDER_ALERT_PHONE=+19015550142

# Optional — only for the proactive missed-call text-back (outbound SMS).
# Inbound replies go out as TwiML and need NO credentials.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Required for live voice (xAI's Grok Voice Agent API). Get one at
# console.x.ai/team/default/api-keys. Used both to register a client's number
# (POST /v2/phone-numbers) and to open the realtime call WebSocket.
# XAI_API_KEY=

# Optional — xAI's SIP "IP allowlist" auth for registered numbers. Comma-
# separated CIDR ranges of Twilio's SIP signaling IPs. If unset, the number is
# registered without an IP allowlist (fine to start; tighten before scaling).
# XAI_SIP_ALLOWED_ADDRESSES=54.172.60.0/23,54.244.51.0/24

# NOTE on the xAI webhook signing secret: it is NOT an environment variable,
# even though it's easy to assume it belongs here next to XAI_API_KEY. It's
# per-business (Business.xai_signing_secret), entered per client via the
# founder console when you register that client's number with xAI — see
# agent/README.md's "AI receptionist" section. There is deliberately no
# XAI_SIGNING_SECRET var to set here.

# Optional — enables "Continue with Google" on the customer portal login.
# Unset simply hides the button rather than erroring (google_auth.py).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional — only needed if the Google OAuth vars above are set. Railway sits
# behind a proxy, so the request scheme can read as http even though the
# public URL is https; set this to pin the OAuth redirect URI and avoid a
# redirect_uri_mismatch.
# OAUTH_REDIRECT_BASE_URL=https://yourdomain.com
