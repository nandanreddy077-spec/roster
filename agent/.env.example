# Required for the AI to generate replies. Get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required to open the founder dashboard (/clients). Any username, this
# password. If unset, the dashboard refuses to serve (fail-closed) — the
# public landing page and /hire flow work regardless.
ADMIN_PASSWORD=pick-a-strong-password

# Optional — only for the proactive missed-call text-back (outbound SMS).
# Inbound replies go out as TwiML and need NO credentials.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Required for live voice (xAI's Grok Voice Agent API). Get one at x.ai.
# XAI_API_KEY=

# Locks down /webhook/xai-incoming-call to real xAI webhook deliveries. If
# unset, the endpoint accepts any request (fine for local dev, NOT for a
# public/deployed URL). Set from the signing secret returned when you
# register a client's number with xAI — see agent/README.md.
# XAI_SIGNING_SECRET=
